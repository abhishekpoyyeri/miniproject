# DATAGUARD AI Environment Variables

# Application Settings
SECRET_KEY=dataguard-ai-super-secret-key-for-jwt-2026
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration (Default SQLite, supports MSSQL or PostgreSQL)
DATABASE_URL=sqlite:///./dataguard.db

# OpenAI API Key for GPT-4o Rule Generation
# (If not provided, DataGuard AI uses built-in heuristic synthesis to guarantee 100% offline functionality)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
OPENAI_TEMPERATURE=0.2
OPENAI_MAX_TOKENS=800

# File Storage
UPLOAD_DIR=./storage/uploads
REPORT_DIR=./storage/reports

